{
  "manifest_version": 3,
  "name": "dev: anchors: LinkedIn Profile Pro (for creators)",
  "version": "1.1.35",
  "key": "",
  "description": "Your personal companion that offers smart analysis of your LinkedIn profiles & creates custom media kits",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "dev: anchors: LinkedIn Profile Pro (for creators)"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "lib/posthog.js",
        "content/content-script.js"
      ]
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/feed-scanner.js"
      ]
    },
    {
      "matches": [
        "https://dev.anchors.pro/*"
      ],
      "js": [
        "lib/posthog.js",
        "content/auth-script.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://dev.anchors.pro/*",
    "https://eu.i.posthog.com/*",
    "https://partners.anchors.in/*",
    "https://*.anchors.in/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://lnkd.in/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://dev.anchors.pro/*",
      "https://*.anchors.in/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/logo.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
